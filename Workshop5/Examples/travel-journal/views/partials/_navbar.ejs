<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/trips">
      <span class="brand-mark" aria-hidden="true">&#9992;</span>
      <span>Travel Journal</span>
    </a>
    <nav aria-label="Main navigation">
      <ul class="nav-links">
        <li><a class="nav-link" href="/trips" <%= title === 'My Trips' || title === 'My Travel Journal' ? 'aria-current="page"' : '' %>>Trips</a></li>
      </ul>
    </nav>
    <div class="header-actions">
      <% if (currentUser) { %>
        <span class="user-chip"><span class="avatar" aria-hidden="true"><%= currentUser.username.charAt(0) %></span><%= currentUser.username %></span>
        <form class="inline-form" action="/logout" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-secondary btn-sm" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a class="btn btn-sm" href="/login">Log in</a>
      <% } %>
    </div>
  </div>
</header>
