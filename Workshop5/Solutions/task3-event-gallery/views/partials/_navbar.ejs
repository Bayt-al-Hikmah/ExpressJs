<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/events">
      <span class="brand-mark" aria-hidden="true">EG</span>
      <span>Event Gallery</span>
    </a>
    <nav aria-label="Main navigation">
      <ul class="nav-links">
        <li><a class="nav-link" href="/events" <%= typeof title !== 'undefined' && title === 'Events' ? 'aria-current="page"' : '' %>>Events</a></li>
      </ul>
    </nav>
    <div class="header-actions">
      <% if (currentUser) { %>
        <span class="user-chip"><span class="avatar" aria-hidden="true"><%= currentUser.username.charAt(0) %></span><%= currentUser.username %></span>
        <form class="inline-form" action="/logout" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-secondary btn-sm" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a class="btn btn-secondary btn-sm" href="/login">Log in</a>
        <a class="btn btn-sm" href="/register">Register</a>
      <% } %>
    </div>
  </div>
</header>
