<%- include('partials/_header', { title: mode === 'login' ? 'Log in' : 'Register' }) %>
<%- include('partials/_navbar') %>

<main id="main">
  <div class="container">
    <div class="auth-wrap">
      <section class="auth-card">
        <% if (mode === 'login') { %>
          <span class="eyebrow">Welcome back</span>
          <h1>Log in</h1>
          <p class="auth-sub">Sign in to create events and upload gallery photos.</p>
        <% } else { %>
          <span class="eyebrow">Join the gallery</span>
          <h1>Create account</h1>
          <p class="auth-sub">Pick a username and a password of at least 12 characters.</p>
        <% } %>

        <% if (error) { %>
          <div class="alert alert--error" role="alert"><span aria-hidden="true">!</span><div><%= error %></div></div>
        <% } %>

        <form method="POST" action="/<%= mode %>" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="field">
            <label for="username">Username</label>
            <input id="username" name="username" type="text" autocomplete="username" minlength="3" maxlength="25" required autofocus>
            <% if (mode === 'register') { %><p class="hint">3–25 characters.</p><% } %>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="<%= mode === 'login' ? 'current-password' : 'new-password' %>" <% if (mode === 'register') { %>minlength="12"<% } %> required>
            <% if (mode === 'register') { %><p class="hint">At least 12 characters.</p><% } %>
          </div>

          <div class="form-actions">
            <button class="btn-block" type="submit"><%= mode === 'login' ? 'Log in' : 'Create account' %></button>
          </div>
        </form>

        <p class="auth-footer">
          <% if (mode === 'login') { %>No account? <a href="/register">Create one</a><% } else { %>Already registered? <a href="/login">Log in</a><% } %>
        </p>
      </section>
    </div>
  </div>
</main>

<%- include('partials/_footer') %>
