<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/products">
      <span class="brand-mark" aria-hidden="true">PC</span>
      <span>Product Catalogue</span>
    </a>
    <nav aria-label="Main navigation">
      <ul class="nav-links">
        <li><a class="nav-link" href="/products" <%= title === 'Products' ? 'aria-current="page"' : '' %>>Products</a></li>
        <% if (currentUser) { %>
          <li><a class="nav-link" href="/products/manage/mine" <%= title === 'Manage Products' ? 'aria-current="page"' : '' %>>Manage</a></li>
        <% } %>
      </ul>
    </nav>
    <div class="header-actions">
      <% if (currentUser) { %>
        <span class="user-chip"><span class="avatar" aria-hidden="true"><%= currentUser.username.charAt(0) %></span><%= currentUser.username %></span>
        <form class="inline-form" action="/logout" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-secondary btn-sm" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a class="btn btn-secondary btn-sm" href="/login">Log in</a>
        <a class="btn btn-sm" href="/register">Register</a>
      <% } %>
    </div>
  </div>
</header>
