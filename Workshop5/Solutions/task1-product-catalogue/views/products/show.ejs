<%- include("../partials/_header") %>
<%- include("../partials/_navbar") %>

<main id="main">
  <div class="container">
    <nav aria-label="Breadcrumb">
      <p class="muted mb-0"><a href="/products">Products</a> <span aria-hidden="true">/</span> <%= product.name %></p>
    </nav>

    <div class="page-head">
      <div>
        <span class="eyebrow">Product</span>
        <h1><%= product.name %></h1>
        <p><%= product.category %> · <strong>$<%= product.price %></strong></p>
      </div>
      <span class="badge badge--brand"><%= product.images.length %> image<%= product.images.length === 1 ? '' : 's' %></span>
    </div>

    <div class="split">
      <section>
        <h2>Gallery</h2>
        <% if (product.images.length > 0) { %>
          <div class="gallery">
            <% product.images.forEach(img => { %>
              <figure class="media-item">
                <img src="/products/images/<%= img.id %>/file" alt="<%= img.originalName || product.name %>">
                <% if (img.isMain) { %><figcaption><span class="badge badge--brand">Main image</span></figcaption><% } %>
              </figure>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">&#128247;</span>
            <h3>No images yet</h3>
            <p>This product does not have any images.</p>
          </div>
        <% } %>
      </section>

      <aside>
        <section class="card">
          <h2>Details</h2>
          <ul class="meta">
            <li><strong>Category:</strong> <%= product.category %></li>
            <li><strong>Price:</strong> $<%= product.price %></li>
          </ul>
          <p><%= product.description || 'No description provided.' %></p>
          <div class="card-footer">
            <a class="btn btn-secondary" href="/products">&larr; Back to products</a>
          </div>
        </section>
      </aside>
    </div>
  </div>
</main>

<%- include("../partials/_footer") %>
