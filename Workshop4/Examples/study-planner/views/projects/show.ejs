<%- include('../partials/_header') %>
<%- include('../partials/_navbar') %>

<main id="main">
  <div class="container">
    <nav aria-label="Breadcrumb" class="mb-0">
      <p class="muted mb-0"><a href="/projects">Projects</a> <span aria-hidden="true">/</span> <%= project.title %></p>
    </nav>

    <div class="page-head">
      <div>
        <span class="eyebrow">Project</span>
        <h1><%= project.title %></h1>
        <% if (project.description) { %><p><%= project.description %></p><% } %>
      </div>
      <span class="badge badge--brand"><%= project.tasks.length %> task<%= project.tasks.length === 1 ? '' : 's' %></span>
    </div>

    <% if (errors.length > 0) { %>
      <div class="error-summary" role="alert">
        <strong>Please fix the following:</strong>
        <ul><% errors.forEach(e => { %><li><%= e.msg %></li><% }); %></ul>
      </div>
    <% } %>

    <div class="split">
      <section>
        <div class="section-head" style="margin-top:0">
          <h2>Tasks</h2>
          <span class="muted"><%= project.tasks.filter(t => t.status === 'COMPLETED').length %> completed</span>
        </div>

        <% if (project.tasks.length > 0) { %>
          <ul class="list">
            <% project.tasks.forEach(t => { %>
              <li class="list-item">
                <div class="list-item-main">
                  <p class="list-item-title"><%= t.title %></p>
                  <% if (t.status === 'COMPLETED') { %>
                    <span class="badge badge--success">Completed</span>
                  <% } else if (t.status === 'IN_PROGRESS') { %>
                    <span class="badge badge--warning">In progress</span>
                  <% } else { %>
                    <span class="badge">To do</span>
                  <% } %>
                </div>
                <div class="cluster">
                  <form class="inline-form" action="/projects/<%= project.id %>/tasks/<%= t.id %>/status" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label class="visually-hidden" for="status-<%= t.id %>">Status for <%= t.title %></label>
                    <select id="status-<%= t.id %>" name="status">
                      <option value="TODO" <%= t.status === 'TODO' ? 'selected' : '' %>>To do</option>
                      <option value="IN_PROGRESS" <%= t.status === 'IN_PROGRESS' ? 'selected' : '' %>>In progress</option>
                      <option value="COMPLETED" <%= t.status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
                    </select>
                    <button class="btn btn-secondary btn-sm" type="submit">Update</button>
                  </form>
                  <form class="inline-form" action="/projects/<%= project.id %>/tasks/<%= t.id %>/delete" method="POST" onsubmit="return confirm('Delete this task?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                  </form>
                </div>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">+</span>
            <h3>No tasks yet</h3>
            <p>Add the first task using the form on the right.</p>
          </div>
        <% } %>
      </section>

      <aside>
        <form class="form-card" action="/projects/<%= project.id %>/tasks" method="POST" novalidate>
          <h2>Add a task</h2>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="field">
            <label for="task-title">Task title <span class="required" aria-hidden="true">*</span></label>
            <input id="task-title" name="title" type="text" value="<%= taskValues.title %>" maxlength="120" required>
          </div>

          <div class="form-actions">
            <button class="btn-block" type="submit">Add task</button>
          </div>
        </form>

        <p class="muted mt-2"><small><a href="/projects">&larr; Back to all projects</a></small></p>
      </aside>
    </div>
  </div>
</main>

<%- include('../partials/_footer') %>
