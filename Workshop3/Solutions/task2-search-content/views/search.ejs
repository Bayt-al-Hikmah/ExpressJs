<%- include('partials/_header') %>
<%- include('partials/_navbar') %>

<main id="main">
  <div class="container container--narrow">
    <div class="page-head">
      <div>
        <span class="eyebrow">Search</span>
        <h1>Search quotes by content</h1>
        <p>Find quotes that contain a word or phrase in the quote text.</p>
      </div>
    </div>

    <form class="form-card" action="/search" method="GET" role="search">
      <div class="field">
        <label for="content">Text in quote</label>
        <input type="search" id="content" name="content" value="<%= content %>" placeholder="e.g. courage" autocomplete="off">
        <p class="hint">Matching is case-insensitive.</p>
      </div>
      <div class="form-actions">
        <button type="submit">Search</button>
        <% if (content) { %><a class="btn btn-secondary" href="/search">Clear</a><% } %>
      </div>
    </form>

    <% if (searched) { %>
      <div class="section-head">
        <h2>Search results</h2>
        <span class="badge badge--brand"><%= quotes.length %> found</span>
      </div>

      <% if (quotes.length > 0) { %>
        <div class="quotes-list">
          <% quotes.forEach(quote => { %>
            <article class="quote-card">
              <blockquote><%= quote.content %></blockquote>
              <p class="quote-meta"><span class="quote-author">— <%= quote.author %></span></p>
              <div class="card-footer">
                <a class="link-arrow" href="/quotes/<%= quote.id %>">View quote</a>
              </div>
            </article>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <span class="empty-icon" aria-hidden="true">?</span>
          <h3>No quotes found</h3>
          <p>No quote text matches “<%= content %>”. Try a different phrase or <a href="/search">clear the search</a>.</p>
        </div>
      <% } %>
    <% } %>
  </div>
</main>

<%- include('partials/_footer') %>
